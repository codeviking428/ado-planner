{
  "name": "ado-planner",
  "version": "0.1.0",
  "description": "Monday-lite Azure DevOps Team Hierarchy Gantt",
  "main": "./out/main/index.js",
  "bin": {
    "ado-planner": "bin/ado-planner.cjs"
  },
  "files": [
    "bin",
    "out",
    "resources",
    "scripts"
  ],
  "author": "ado-planner",
  "homepage": "https://github.com/codeviking428/ado-planner",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeviking428/ado-planner.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --remoteDebuggingPort=9222",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "node scripts/postinstall.cjs",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac": "pnpm build && electron-builder --mac",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "prepare": "node scripts/prepare.cjs"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.4",
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/react-query": "^5.90.16",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "azure-devops-node-api": "^15.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.7.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "lefthook": "^2.0.12",
    "oxfmt": "^0.18.0",
    "oxlint": "^1.32.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "lefthook"
    ]
  }
}
